# Configure on the server only. Do not put credentials in NEXT_PUBLIC_ variables.
# deepseek (default) or bedrock
CADLINT_AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# Optional; defaults to deepseek-flash.
DEEPSEEK_MODEL=deepseek-flash
# Optional vision fallback settings for outlined/image-only PDF pages.
DEEPSEEK_VISION_MODEL=deepseek-flash
# For Bedrock: set CADLINT_AI_PROVIDER=bedrock, AWS_REGION, BEDROCK_MODEL_ID.
# Use an image-capable Claude or GPT inference profile available to this AWS account.
# Production: grant bedrock:InvokeModel to the app's IAM role. Do not store AWS keys here.
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=us.openai.gpt-6.1-sol
# CADLINT_PDFTOPPM=/absolute/path/to/pdftoppm
